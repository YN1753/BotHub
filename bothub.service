[Unit]
Description=Vesper BotHub - Intelligent Automation & Multi-Bot Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bothub
ExecStart=/opt/bothub/bothub -addr :8080 -db /opt/bothub/data/bothub.db
Environment=TZ=Asia/Shanghai
# Optional: override admin token via environment
# Environment=BOTHUB_ADMIN_TOKEN=change-me-strong-token
Restart=always
RestartSec=3
LimitNOFILE=65535

# Linux Kernel Hardening & Isolation
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/opt/bothub/data

[Install]
WantedBy=multi-user.target
